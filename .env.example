# ===== 复制本文件为 .env 后填写真实值，.env 不会被提交到 Git =====

# 服务端口
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/rag_kb_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change_me

# Redis（需要带 RediSearch 模块，见 docker-compose.yml）
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# 上传大小上限
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=20MB
